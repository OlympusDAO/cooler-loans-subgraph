{
  "name": "cooler-loans-subgraph",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "codegen": "rm -rf generated && graph codegen",
    "build": "graph build",
    "deploy": "graph deploy --studio --version-label=$(cat .subgraph-version | tr -d '[:space:]') cooler-loans",
    "deploy:goerli": "graph deploy --studio --version-label=$(cat .subgraph-version | tr -d '[:space:]') cooler-loans-goerli",
    "test": "graph test",
    "create-local": "graph create --node http://localhost:8020/ cooler-loans",
    "remove-local": "graph remove --node http://localhost:8020/ cooler-loans",
    "deploy-local": "graph deploy --node http://localhost:8020/ --ipfs http://localhost:5001 cooler-loans",
    "preinstall": "npx only-allow pnpm"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@graphprotocol/graph-cli": "^0.97.1",
    "@graphprotocol/graph-ts": "^0.38.1"
  },
  "devDependencies": {
    "@types/node": "^18",
    "assemblyscript-prettier": "^3.0.1",
    "matchstick-as": "0.6.0",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "pnpm": "10.33.0",
    "npm": "use-pnpm",
    "yarn": "use-pnpm"
  }
}
